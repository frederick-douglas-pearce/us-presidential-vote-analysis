# Python
__pycache__/
*.pyc
*.egg-info/
.venv/

# Build output
dist/
build/

# uv manages the environment; uv.lock IS committed for reproducible installs.

# Jupyter
.ipynb_checkpoints/

# Testing / coverage
.coverage
coverage/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment / secrets
.env
.env.local

# API snapshot copied into the repo root for `docker build` (the baked-in artifact,
# built outside the tree by `python -m usvote.snapshot`). Gitignored so it is never
# committed and — because hatchling's `packages` layout respects .gitignore — never
# bundled into the wheel either. It is still available to `docker build` (.dockerignore
# keeps it in the build context).
/api_snapshot.sqlite
*.sqlite

# Claude Code local settings
.claude/settings.local.json

# IDE / OS
.vscode/
.idea/
.DS_Store

# dev-loop ledger (local working state, never committed)
.claude/loop/

# Outreach working area (blog post drafts, social copy, etc.). Mirrors the
# claude-code-sessions policy — pre-publication scratch stays untracked, curated
# assets are tracked — with one deviation that matters here: `social/candidates.md`
# carries `outreach`-lane entries, which are findings about a data provider that
# guardrail G1 says go to that provider privately and are never published. This repo
# is public, so the ledger (and the drafts, and the scout config) stay untracked.
# Only the rendered OG cards and their committable build inputs are versioned.
/social/*
!/social/images/

# Node toolchain for the Prettier gate on posts/ (package.json + the lockfile
# are tracked; the installed tree is not).
node_modules/
